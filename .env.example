# ═══════════════════════════════════════════════════════
# ADMIN
# ═══════════════════════════════════════════════════════
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# ═══════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/dbname
DB_USER=user
DB_PASS=pass
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dbname
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ═══════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════
REDIS_URL=redis://:password@localhost:6379/0
REDIS_CACHE_URL=redis://:password@localhost:6379/1
REDIS_LIMITER_URL=redis://:password@localhost:6379/2
REDIS_CELERY_URL=redis://:password@localhost:6379/3

# ═══════════════════════════════════════════════════════
# GUNICORN
# ═══════════════════════════════════════════════════════
GUNICORN_BIND=0.0.0.0:10000
GUNICORN_WORKERS=2
GUNICORN_LOGLEVEL=info

# ═══════════════════════════════════════════════════════
# FLASK
# ═══════════════════════════════════════════════════════
FLASK_ENV=production
FLASK_DEBUG=False

# ═══════════════════════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════════════════════
SECRET_KEY=run_python_secrets_token_hex_32
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=True

# ═══════════════════════════════════════════════════════
# AI APIs
# ═══════════════════════════════════════════════════════
DEEPGRAM_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# ═══════════════════════════════════════════════════════
# GOOGLE OAUTH
# ═══════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════
# EMAIL
# ═══════════════════════════════════════════════════════
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# ═══════════════════════════════════════════════════════
# eSewa
# ═══════════════════════════════════════════════════════
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
ESEWA_ENVIRONMENT=test